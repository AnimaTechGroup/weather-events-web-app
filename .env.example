# Optional. When set, the app GETs gold JSON from this origin instead of mocks.
# Example after the lake publishes files:
#   https://cdn.example.com/gold/weather-events
# Expected files:
#   {VITE_GOLD_BASE_URL}/quakes_yearly.json
#   {VITE_GOLD_BASE_URL}/quakes_yearly_by_country.json
#   {VITE_GOLD_BASE_URL}/tornadoes_yearly.json
#   {VITE_GOLD_BASE_URL}/tornadoes_yearly_by_state.json
#   {VITE_GOLD_BASE_URL}/cyclones_yearly.json
#   {VITE_GOLD_BASE_URL}/cyclones_yearly_by_basin.json
VITE_GOLD_BASE_URL=

# Shown in the footer so the UI can say "mock" vs "lake".
VITE_DATA_MODE=mock
