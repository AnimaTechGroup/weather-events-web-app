# Data source (pick one mode)
#
# 1) Mock (default) — leave gold vars empty
# VITE_DATA_MODE=mock
#
# 2) Private lake API (recommended) — app key + CORS, no user login
# VITE_GOLD_API_URL=https://xxxx.execute-api.us-east-1.amazonaws.com
# VITE_GOLD_API_KEY=<terraform output -raw weather_events_gold_api_key>
# VITE_DATA_MODE=lake
#
# Endpoints (Meridian sends header X-Gold-Api-Key):
#   GET {VITE_GOLD_API_URL}/v1/tornadoes/yearly
#   GET {VITE_GOLD_API_URL}/v1/tornadoes/by-region
#
# 3) Legacy public JSON URL — avoid for private lake data
# VITE_GOLD_BASE_URL=https://cdn.example.com/gold/weather-events

VITE_GOLD_API_URL=
VITE_GOLD_API_KEY=
VITE_GOLD_BASE_URL=
VITE_DATA_MODE=mock
